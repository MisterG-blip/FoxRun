        "then": {          
          "s1" : "off",
          "s2" : "off",
          "s3" : "off",
          "s4" : "off",
          "s5" : "off"
        }
      },
      {
        "when": "!h1:off && !h2:off && h3:off && s1:on && !s2:on && s3:on && !s4:on && s5:on",
        "then": {
          "door_m1" : "open",
          "door_m2" : "open",
          "h3" : "on",
          "s1" : "off",
          "s2" : "off",
          "s3" : "off",
          "s4" : "off",
          "s5" : "off"
        }
      },
      {
        "when": "!h1:off && !h2:off && h3:off && (s2:on || s4:on )",
        "then": {          
          "s1" : "off",
          "s2" : "off",
          "s3" : "off",
          "s4" : "off",
          "s5" : "off"
        }
      },
      {
        "when": "!h1:off && !h2:off && !h3:off && !s1:on && s2:on && !s3:on && s4:on && !s5:on",
        "then": {
          "door_m" : "open"
        }
      },
      {
        "when": "!h1:off && !h2:off && !h3:off && (s1:on || s3:on || s5:on )",
        "then": {          
          "s1" : "off",
          "s2" : "off",
          "s3" : "off",
          "s4" : "off",
          "s5" : "off"
        }
